{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "deny": [
        "Bash(git add *)",
        "Bash(git commit *)",
        "Bash(git merge *)",
        "Bash(git rebase *)",
        "Bash(git push *)",
        "Bash(git reset *)",
        "Bash(git checkout *)",
        "Bash(git switch *)",
        "Bash(git stash *)",
        "Bash(git tag *)",
        "Bash(git restore *)",
        "Bash(git cherry-pick *)",
        "Bash(git revert *)",
        "Bash(git clean *)",
        "Bash(git branch -d *)",
        "Bash(git branch -D *)",
        "Edit(/.claude/settings.json)",
        "Edit(/.claude/hooks/**)",
        "Read(./.env)",
        "Read(./.env.*)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-write.js"
            }
          ]
        }
      ]
    }
  }
{
  "name": "unified-service-scheduler",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=tests/unit --passWithNoTests",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "eslint .",
    "db:seed": "tsc prisma/seed.ts --ignoreConfig --outDir dist/seed --rootDir . --module commonjs --target ES2021 --strict --skipLibCheck --types node && node dist/seed/prisma/seed.js",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm prisma validate && pnpm build && pnpm --filter frontend typecheck && pnpm --filter frontend lint && pnpm --filter frontend test && pnpm --filter frontend build"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
